# Copia este archivo a .env.local y llena los valores de TU proyecto de Supabase.
# Nunca subas .env.local al repositorio.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (no usar en el navegador)
SUPABASE_SERVICE_ROLE_KEY=

# Fase 9: PAC (ambiente de pruebas)
PAC_API_URL=
PAC_API_USER=
PAC_API_KEY=

# Hoja de Google (cuenta de servicio con acceso solo a la hoja)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
